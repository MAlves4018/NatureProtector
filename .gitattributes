# Keep shell scripts portable across Windows and Linux runners.
*.sh text eol=lf

# Biome quality gates require LF line endings for frontend sources.
webUI/** text eol=lf

# Explicit binary classification without imposing repository-wide line-ending changes.
*.db binary
*.sqlite binary
*.sqlite3 binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.woff binary
*.woff2 binary
