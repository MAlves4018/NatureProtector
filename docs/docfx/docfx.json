{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "artifacts/api-input",
          "files": [
            "**/*.dll",
            "**/*.xml"
          ],
          "exclude": [
            "**/*.Tests.dll",
            "**/*.Tests.xml"
          ]
        }
      ],
      "dest": "api",
      "shouldSkipMarkup": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml",
          "openapi-future.md",
          "api/**.yml",
          "api/toc.yml",
          "../**/*.md",
          "../../README.md",
          "../../data/README.md",
          "../../scripts/data/README.md"
        ],
        "exclude": [
          "**/bin/**",
          "**/obj/**",
          "../docfx/output/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "../architecture/diagrams/**",
          "../architecture/images/**",
          "../study/assets/**"
        ]
      }
    ],
    "output": "output",
    "template": [
      "default",
      "modern"
    ],
    "disableGitFeatures": true,
    "globalMetadata": {
      "_appTitle": "NatureProtector Documentation",
      "_appName": "NatureProtector",
      "_enableSearch": true
    }
  }
}
