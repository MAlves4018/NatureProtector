info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1ms) [Parameters=[@__resolvedConfigurationVersion_Value_0='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']
      SELECT a."Id", a."Code", a."Name", a."CountryCode", c."VersionNumber", (
          SELECT count(*)::int
          FROM control.grid_cells AS g
          WHERE g."AreaId" = a."Id"), (
          SELECT count(*)::int
          FROM control.sensor_nodes AS s
          WHERE s."AreaId" = a."Id" AND s."IsActive"), (
          SELECT count(*)::int
          FROM control.scenario_definitions AS s0
          WHERE s0."AreaId" = a."Id")
      FROM control.areas AS a
      INNER JOIN control.configuration_versions AS c ON a."ConfigurationVersionId" = c."Id"
      WHERE c."VersionNumber" = @__resolvedConfigurationVersion_Value_0
      ORDER BY a."Name"
