      SELECT s1."CellCode", s1."Id", s1."Id0", s1."Id1", s2."Id", s2.c, s1."VersionNumber", s1."CentroidLatitude", s1."CentroidLongitude", s1."AltitudeMeters", s1."SlopeDegrees", s1."AspectDegrees", s1."LandCoverClass", s1."DominantForestType", s1."DominantFuelModel", s1."TreeCoverDensity", s1."StructuralHazard", s1."ConjuncturalHazard", s1.c
      FROM (
          SELECT g."CellCode", c."VersionNumber", g."CentroidLatitude", g."CentroidLongitude", g."AltitudeMeters", g."SlopeDegrees", g."AspectDegrees", g."LandCoverClass", g."DominantForestType", g."DominantFuelModel", g."TreeCoverDensity", g."StructuralHazard", g."ConjuncturalHazard", (
