      SELECT s."Id", a."Code", s."ScenarioCode", s."ScenarioName", CASE s."Status"
          WHEN 0 THEN 'Defined'
          WHEN 1 THEN 'Ready'
          WHEN 2 THEN 'Running'
          WHEN 3 THEN 'Completed'
          WHEN 4 THEN 'Failed'
          WHEN 5 THEN 'Cancelled'
          ELSE s."Status"::text
      END, c."VersionNumber", s."CreatedAt", s."StartedAt", s."EndedAt", s."LogicalStartTimestamp", s."IntervalSeconds", s."NumberOfCycles", s."ExecutionSeed", s."MetadataJson"
      FROM control.simulation_runs AS s
