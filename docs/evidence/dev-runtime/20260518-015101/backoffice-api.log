      Executed DbCommand (1ms) [Parameters=[@__areaCode_0='?', @__resolvedConfigurationVersion_Value_1='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']
      SELECT s."Id", s."Code", s."Name", CASE s."ScenarioKind"
          WHEN 0 THEN 'Base'
          WHEN 1 THEN 'HighRisk'
          WHEN 2 THEN 'Failure'
          WHEN 3 THEN 'Exercise'
          ELSE s."ScenarioKind"::text
      END, c."VersionNumber", s."Description", CASE
          WHEN s."BaseScenarioId" IS NULL THEN NULL
          ELSE (
              SELECT s0."Code"
              FROM control.scenario_definitions AS s0
              WHERE s0."Id" = s."BaseScenarioId"
              LIMIT 1)
      END, (
          SELECT count(*)::int
          FROM control.scenario_dataset_bindings AS s1
          WHERE s1."ScenarioId" = s."Id")
      FROM control.scenario_definitions AS s
      INNER JOIN control.areas AS a ON s."AreaId" = a."Id"
      INNER JOIN control.configuration_versions AS c ON s."ConfigurationVersionId" = c."Id"
      WHERE a."Code" = @__areaCode_0 AND c."VersionNumber" = @__resolvedConfigurationVersion_Value_1
      ORDER BY s."Code"
