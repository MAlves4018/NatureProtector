      WHERE (e."Status" = 5 AND e."NextAttemptNotBefore" IS NOT NULL AND e."NextAttemptNotBefore" <= @__now_0) OR (e."Status" = 1 AND e."LastAttemptAt" IS NOT NULL AND e."LastAttemptAt" <= @__staleProcessingCutoff_1)
      ORDER BY CASE
          WHEN e."Status" = 5 THEN 0
          ELSE 1
      END, COALESCE(e."NextAttemptNotBefore", e."LastAttemptAt", e."ReceivedAt")
      LIMIT 1

