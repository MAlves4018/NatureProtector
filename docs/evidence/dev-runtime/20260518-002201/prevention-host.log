info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1ms) [Parameters=[@__now_0='?' (DbType = DateTime), @__staleProcessingCutoff_1='?' (DbType = DateTime)], CommandType='Text', CommandTimeout='30']
      SELECT e."Id", e."AreaId", e."AttemptCount", e."CorrelationId", e."EnvelopeJson", e."EventId", e."EventTime", e."EventType", e."IngestTime", e."LastAttemptAt", e."LastErrorCode", e."LastErrorMessage", e."LastProcessedAt", e."NextAttemptNotBefore", e."PayloadJson", e."Producer", e."QuarantinedAt", e."ReceivedAt", e."SchemaVersion", e."Status"
