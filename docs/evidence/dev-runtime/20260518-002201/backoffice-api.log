          SELECT g."CellCode", c."VersionNumber", g."CentroidLatitude", g."CentroidLongitude", g."AltitudeMeters", g."SlopeDegrees", g."AspectDegrees", g."LandCoverClass", g."DominantForestType", g."DominantFuelModel", g."TreeCoverDensity", g."StructuralHazard", g."ConjuncturalHazard", (
              SELECT count(*)::int
              FROM control.sensor_nodes AS s0
              WHERE s0."GridCellId" = g."Id" AND s0."IsActive") AS c, g."Id", a."Id" AS "Id0", c."Id" AS "Id1"
          FROM control.grid_cells AS g
          INNER JOIN control.areas AS a ON g."AreaId" = a."Id"
          INNER JOIN control.configuration_versions AS c ON g."ConfigurationVersionId" = c."Id"
          WHERE a."Code" = @__areaCode_0 AND c."VersionNumber" = @__resolvedConfigurationVersion_Value_1
          ORDER BY g."CellCode"
          LIMIT @__p_3 OFFSET @__p_2
      ) AS s1
      LEFT JOIN (
          SELECT s."Id", CASE s."Type"
              WHEN 0 THEN 'Temperature'
              WHEN 1 THEN 'Humidity'
              WHEN 2 THEN 'Wind'
              WHEN 3 THEN 'WeatherStation'
              WHEN 4 THEN 'Composite'
              ELSE s."Type"::text
          END AS c, s."GridCellId"
          FROM control.sensor_nodes AS s
          WHERE s."IsActive"
      ) AS s2 ON s1."Id" = s2."GridCellId"
      ORDER BY s1."CellCode", s1."Id", s1."Id0", s1."Id1"
