# Doxyfile for NatureProtector
# Run from the repository root.

DOXYFILE_ENCODING      = UTF-8

PROJECT_NAME           = "NatureProtector"
PROJECT_BRIEF          = "Plataforma de simulação de risco operacional e prevenção de incêndios rurais."
OUTPUT_DIRECTORY       = docs/doxygen/output-local
OUTPUT_LANGUAGE        = English
MARKDOWN_SUPPORT       = YES
MARKDOWN_STRICT        = YES
MARKDOWN_ID_STYLE      = GITHUB
TOC_INCLUDE_HEADINGS   = 6
FULL_PATH_NAMES        = YES
NUM_PROC_THREADS       = 0
TIMESTAMP              = NO

INPUT                  = src \
                         docs \
                         README.md \
                         data/README.md \
                         infra/README.md \
                         scripts/data/README.md \
                         tests/README.md

FILE_PATTERNS          = *.cs \
                         *.md \
                         *.markdown \
                         *.dox

RECURSIVE              = YES

EXCLUDE_PATTERNS       = */bin/* \
                         */obj/* \
                         */.git/* \
                         */.github/* \
                         */.vs/* \
                         */.vscode/* \
                         */.idea/* \
                         */.venv/* \
                         */docs/doxygen/output/* \
                         */docs/doxygen/output-local/*

USE_MDFILE_AS_MAINPAGE = docs/doxygen/pages/mainpage.md
IMPLICIT_DIR_DOCS      = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_PACKAGE        = YES

HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_UNDOC_NAMESPACES  = NO
HIDE_FRIEND_COMPOUNDS  = NO
HIDE_IN_BODY_DOCS      = NO
SHOW_HEADERFILE        = YES
SHOW_INCLUDE_FILES     = YES
SHOW_USED_FILES        = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file:$line: $text"
WARN_LINE_FORMAT       = "at line $line of file $file"

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO
VERBATIM_HEADERS       = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
PAGE_OUTLINE_PANEL     = YES
FULL_SIDEBAR           = NO
SEARCHENGINE           = YES

GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_DOCBOOK       = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = YES

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
SEARCH_INCLUDES        = YES
SKIP_FUNCTION_MACROS   = YES

HAVE_DOT               = YES
DOT_NUM_THREADS        = 0
DOT_IMAGE_FORMAT       = png
DOT_PATH               =
DOT_GRAPH_MAX_NODES    = 80
MAX_DOT_GRAPH_DEPTH    = 0
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DIR_GRAPH_MAX_DEPTH    = 2
GENERATE_LEGEND        = YES
DOT_CLEANUP            = YES

PLANTUML_JAR_PATH      = C:/Users/Miguel/Tools/plantuml/plantuml.jar
PLANTUML_CFG_FILE      =
PLANTUML_INCLUDE_PATH  = docs/architecture/diagrams \
                         docs/doxygen/pages
PLANTUMLFILE_DIRS      = docs/architecture/diagrams \
                         docs/doxygen/pages
