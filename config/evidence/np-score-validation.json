  "claimBoundary": {
    "evidenceClass": "exploratory-retrospective",
    "scoreMeaning": "relative danger index, not calibrated probability",
    "allowed": [
      "behavioural coherence",
      "retrospective discrimination",
      "comparison with baselines",
      "threshold alignment",
      "sensitivity and ablation findings"
