        6
      ],
      "cases": [
        {
          "id": "nominal-short",
          "kind": "api-run",
          "areaCode": "proenca-a-nova",
          "scenarioCode": "scenario_b",
          "sensorCount": 6,
          "numberOfCycles": 5,
          "intervalSeconds": 5,
          "seed": 12345,
          "degradationProfiles": [],
          "collectEvidence": true,
          "timeoutSeconds": 180
        },
        {
          "id": "nominal-long",
          "kind": "api-run",
          "areaCode": "proenca-a-nova",
          "scenarioCode": "scenario_b",
          "sensorCount": 6,
          "numberOfCycles": 6,
          "intervalSeconds": 60,
          "seed": 12345,
          "degradationProfiles": [],
          "collectEvidence": true,
          "timeoutSeconds": 600
        }
      ]
    },
    {
