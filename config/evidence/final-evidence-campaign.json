          "sensorCount": 2,
          "numberOfCycles": 4,
          "intervalSeconds": 10,
          "seed": 12345,
          "degradationProfiles": [
            "missing"
          ],
          "collectEvidence": true,
          "timeoutSeconds": 180
        },
        {
          "id": "noise-drift",
          "kind": "api-run",
          "areaCode": "proenca-a-nova",
          "scenarioCode": "scenario_c",
          "sensorCount": 2,
