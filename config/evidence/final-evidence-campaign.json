        }
      ]
    },
    {
      "id": "E3",
      "title": "Temporal membership and snapshots",
      "claims": [
        "Expected membership, explicit missing observations and cycle snapshots remain run-scoped."
      ],
      "reportChapters": [
        4,
        5,
        6
      ],
      "cases": [
        {
          "id": "temporal-missing",
          "kind": "api-run",
          "areaCode": "proenca-a-nova",
          "scenarioCode": "scenario_c",
          "sensorCount": 2,
          "numberOfCycles": 6,
          "intervalSeconds": 10,
          "seed": 12345,
          "degradationProfiles": [
            "missing",
            "out-of-order",
            "duplicate"
          ],
          "collectEvidence": true,
          "timeoutSeconds": 240
        }
      ]
    },
    {
      "id": "E4",
      "title": "Lifecycle and recovery",
      "claims": [
        "Timeout, cancellation, non-zero exit, orphan reconciliation and reset produce explicit outcomes."
      ],
      "reportChapters": [
        5,
        6,
        7
      ],
      "cases": [
        {
          "id": "lifecycle-tests",
          "kind": "command",
          "command": [
            "dotnet",
            "test",
            "NatureProtector.sln",
            "-c",
            "Release",
            "--filter",
            "FullyQualifiedName~RuntimeOperation|FullyQualifiedName~RuntimeReset"
          ],
          "successPatterns": [
            "Passed!",
            "Test Run Successful",
            "Total tests",
            "SYSTEM_CAPACITY_WORKLOAD_PASS",
            "MULTI_REPLICA_TEMPORAL_CORRECTNESS_PASS"
          ]
        }
      ]
    },
    {
      "id": "E5",
      "title": "Multi-replica correctness",
      "claims": [
        "One, two and three Prevention replicas preserve unique settlements and snapshots."
      ],
      "reportChapters": [
        5,
        6,
        7
      ],
      "cases": [
        {
          "id": "postgres-concurrency",
          "kind": "command",
          "command": [
            "dotnet",
            "test",
            "tests/NatureProtector.IntegrationTests/NatureProtector.IntegrationTests.csproj",
            "-c",
            "Release",
            "--filter",
            "FullyQualifiedName~PreventionWorker_CompetingConsumersProcessDistinctEventsWithoutDuplicateEffects",
            "--no-build"
          ],
          "successPatterns": [
            "Passed!",
            "Test Run Successful",
            "Total tests",
            "System capacity workload complete",
            "SYSTEM_CAPACITY_WORKLOAD_PASS",
            "MULTI_REPLICA_TEMPORAL_CORRECTNESS_PASS"
          ]
        }
      ]
    },
    {
      "id": "E6",
      "title": "Performance and capacity",
      "claims": [
        "Throughput, backlog, latency percentiles and settlement lag are measured before scaling."
      ],
      "reportChapters": [
        6,
        7
      ],
      "cases": [
        {
          "id": "capacity-workload",
          "kind": "command",
          "command": [
            "pwsh",
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            "scripts/performance/run-system-capacity-workload.ps1"
          ],
          "successPatterns": [
            "Passed!",
            "Test Run Successful",
            "Total tests",
            "System capacity workload complete",
            "SYSTEM_CAPACITY_WORKLOAD_PASS",
            "MULTI_REPLICA_TEMPORAL_CORRECTNESS_PASS"
          ]
        }
      ]
    }
  ]
}
