COMPOSE_PROJECT_NAME=natureprotector

# Clone-to-run:
#   .\scripts\np.ps1 init-local -Force
# generates a real local .env from this template.
# Do not copy this file blindly and keep INFLUXDB_TOKEN as a placeholder.

RABBITMQ_DEFAULT_USER=np
RABBITMQ_DEFAULT_PASS=np_dev_pass
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

POSTGRES_DB=natureprotector
POSTGRES_USER=np
POSTGRES_PASSWORD=np_dev_pass
POSTGRES_PORT=5433

# Generated by scripts\setup\New-LocalDotEnv.ps1.
# The real .env value must start with apiv3_ and must not be committed.
INFLUXDB_TOKEN=<generated-by-init-local>
INFLUXDB_PORT=8181
INFLUXDB_DATABASE=np_telemetry
INFLUXDB_ORGANIZATION=natureprotector
INFLUXDB_BUCKET=np_telemetry

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

NP_BOOTSTRAP_ADMIN_USERNAME=admin
# Local/dev only. Generated into .env by init-local for clone-to-run.
NP_BOOTSTRAP_ADMIN_PASSWORD=<generated-local-dev-password>

BACKOFFICE_API_PORT=5254
WEBUI_PORT=5173
