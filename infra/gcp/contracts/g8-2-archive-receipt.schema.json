{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://natureprotector.local/schemas/g8-2-archive-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "qualification_id",
    "status",
    "bucket",
    "archive_prefix",
    "archived_at",
    "retention_days",
    "versioning_enabled",
    "public_access_prevention",
    "objects",
    "pre_archive_verdict_sha256",
    "evidence_index_sha256",
    "candidate_manifest_sha256",
    "production_authorized",
    "production_deployed"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "phase": {
      "const": "G8.2"
    },
    "qualification_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"
    },
    "status": {
      "enum": [
        "passed",
        "blocked"
      ]
    },
    "bucket": {
      "type": "string",
      "pattern": "^gs://[a-z0-9][a-z0-9._-]{1,221}[a-z0-9]$"
    },
    "archive_prefix": {
      "type": "string",
      "minLength": 1
    },
    "archived_at": {
      "type": "string",
      "format": "date-time"
    },
    "retention_days": {
      "type": "integer",
      "minimum": 0
    },
    "versioning_enabled": {
      "type": "boolean"
    },
    "public_access_prevention": {
      "type": "boolean"
    },
    "objects": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "generation",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "generation": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "pre_archive_verdict_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_index_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "production_authorized": {
      "const": false
    },
    "production_deployed": {
      "const": false
    }
  }
}
