{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://natureprotector.local/schemas/g8-2-authorization-decision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "qualification_id",
    "status",
    "decision",
    "authorizer_identity",
    "independent_reviewer_identity",
    "executor_identity",
    "authorization_request_sha256",
    "candidate_manifest_sha256",
    "evidence_index_sha256",
    "final_qualification_verdict_sha256",
    "archive_receipt_sha256",
    "independent_review_sha256",
    "independent_review_verdict_sha256",
    "source_commit",
    "environment",
    "scope",
    "issued_at",
    "expires_at",
    "rollback_owner",
    "conditions",
    "signature_namespace",
    "production_authorized",
    "production_deployed"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "phase": {
      "const": "G8.2"
    },
    "qualification_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"
    },
    "status": {
      "enum": [
        "UNSIGNED_NOT_AUTHORIZED",
        "SIGNED"
      ]
    },
    "decision": {
      "enum": [
        "GO",
        "NO_GO"
      ]
    },
    "authorizer_identity": {
      "type": "string",
      "minLength": 1
    },
    "independent_reviewer_identity": {
      "type": "string",
      "minLength": 1
    },
    "executor_identity": {
      "type": "string",
      "minLength": 1
    },
    "authorization_request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_index_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "final_qualification_verdict_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "archive_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "independent_review_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "independent_review_verdict_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "environment": {
      "const": "production"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "rollback_owner": {
      "type": "string",
      "minLength": 1
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "owner",
          "due_at",
          "risk_reduction_only"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "due_at": {
            "type": "string",
            "format": "date-time"
          },
          "risk_reduction_only": {
            "const": true
          }
        }
      }
    },
    "signature_namespace": {
      "const": "natureprotector-g82-production-authorization"
    },
    "production_authorized": {
      "type": "boolean"
    },
    "production_deployed": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "GO"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "SIGNED"
          },
          "production_authorized": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "NO_GO"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "production_authorized": {
            "const": false
          }
        }
      }
    }
  ]
}
