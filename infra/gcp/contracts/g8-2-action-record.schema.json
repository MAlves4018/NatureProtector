{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://natureprotector.local/schemas/g8-2-action-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "qualification_id",
    "action",
    "repository",
    "repository_id",
    "source_commit",
    "candidate_manifest_sha256",
    "workflow",
    "status",
    "started_at",
    "finished_at",
    "producer",
    "subject",
    "measurements",
    "evidence_files",
    "production_authorized",
    "production_deployed"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "phase": {
      "const": "G8.2"
    },
    "qualification_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$"
    },
    "action": {
      "enum": [
        "pilot-1",
        "pilot-2",
        "pilot-3",
        "soak-start",
        "soak-observe",
        "soak-finish",
        "capacity",
        "security-rotation",
        "incident-drill",
        "collect-audit",
        "cost-observation",
        "second-operator",
        "rollback-drill",
        "teardown-rehearsal"
      ]
    },
    "repository": {
      "const": "MAlves4018/NatureProtector"
    },
    "repository_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "run_attempt",
        "name",
        "path",
        "event",
        "environment",
        "actor"
      ],
      "properties": {
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "const": "G8.2 runtime qualification"
        },
        "path": {
          "const": ".github/workflows/gcp-g8-2-runtime-qualification.yml"
        },
        "event": {
          "const": "workflow_dispatch"
        },
        "environment": {
          "const": "staging"
        },
        "actor": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "const": "passed"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "algorithm",
        "version"
      ],
      "properties": {
        "script": {
          "type": "string",
          "pattern": "^scripts/cloud/[A-Za-z0-9._-]+$"
        },
        "algorithm": {
          "type": "string",
          "minLength": 3
        },
        "version": {
          "const": 2
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": true
    },
    "measurements": {
      "type": "object",
      "additionalProperties": true
    },
    "evidence_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "enum": [
              "raw-measurement",
              "execution-metadata",
              "logs",
              "metrics",
              "audit",
              "drill-result",
              "cost-export",
              "operator-evidence",
              "manifest",
              "other"
            ]
          }
        }
      }
    },
    "production_authorized": {
      "const": false
    },
    "production_deployed": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "pilot-1"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "subject": {
            "type": "object",
            "required": [
              "execution_id",
              "simulation_run_id"
            ],
            "properties": {
              "execution_id": {
                "type": "string",
                "minLength": 1
              },
              "simulation_run_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "additionalProperties": true
          },
          "measurements": {
            "type": "object",
            "required": [
              "produced_events",
              "processed_events",
              "failed_events",
              "confirmed_message_loss",
              "availability_window_seconds",
              "unavailable_seconds",
              "latency_histogram"
            ],
            "properties": {
              "produced_events": {
                "type": "integer",
                "minimum": 1
              },
              "processed_events": {
                "type": "integer",
                "minimum": 0
              },
              "failed_events": {
                "type": "integer",
                "minimum": 0
              },
              "confirmed_message_loss": {
                "type": "integer",
                "minimum": 0
              },
              "availability_window_seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unavailable_seconds": {
                "type": "number",
                "minimum": 0
              },
              "latency_histogram": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "unit",
                  "count",
                  "sum",
                  "buckets"
                ],
                "properties": {
                  "unit": {
                    "const": "seconds"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "sum": {
                    "type": "number",
                    "minimum": 0
                  },
                  "buckets": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "le",
                        "cumulative_count"
                      ],
                      "properties": {
                        "le": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "cumulative_count": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  }
                }
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
