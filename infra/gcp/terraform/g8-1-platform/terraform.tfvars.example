platform_project_id        = "np-platform-REPLACE"
staging_project_id         = "np-staging-REPLACE"
production_project_id      = "np-production-REPLACE"
repository_id              = "REPLACE_NUMERIC_ID"
repository_owner_id        = "REPLACE_NUMERIC_OWNER_ID"
evidence_bucket_name       = "np-evidence-REPLACE"
terraform_state_bucket_name = "np-tfstate-REPLACE"
staging_cloud_deploy_worker_pool = "projects/np-staging-REPLACE/locations/europe-southwest1/workerPools/np-staging-deploy"
production_cloud_deploy_worker_pool = "projects/np-production-REPLACE/locations/europe-southwest1/workerPools/np-production-deploy"
staging_gke_node_service_account = "np-staging-gke-nodes@np-staging-REPLACE.iam.gserviceaccount.com"
production_gke_node_service_account = "np-production-gke-nodes@np-production-REPLACE.iam.gserviceaccount.com"
create_delivery_control_plane = false
create_delivery_pipelines     = false
# Bootstrap order:
# 1. Enable only create_delivery_control_plane; keep the pipeline phase disabled.
# 2. Apply both environment roots using the platform identity outputs.
# 3. Populate worker-pool/node-SA outputs and apply this root with both flags true.
# owner_creation_confirmation = "OWNER_APPROVES_NEW_NON_CN_GCP_PROJECTS_AFTER_G10"

# Populate these maps only after the staging and production environment roots
# have created their service accounts, network, Cloud SQL instance and secrets.
# Values are target-specific and must never contain secret payloads.
