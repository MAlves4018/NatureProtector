  environment            = "staging"
  api_min_scale          = "0"
  api_max_scale          = "2"
  frontend_min_scale     = "0"
  frontend_max_scale     = "2"
  cloud_sql_private_ip   = "REPLACE_AFTER_STAGING_APPLY"
}

