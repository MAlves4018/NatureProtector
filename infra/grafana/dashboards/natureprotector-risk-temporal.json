      "id": 1,
      "title": "Area cycle snapshots",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "natureprotector-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "natureprotector-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \"SnapshotTimestamp\" AS \"time\", \"SimulationRunId\" AS simulation_run_id, \"CycleIndex\" AS cycle_index, \"ExpectedCount\" AS expected_count, \"ObservedCount\" AS observed_count, \"MissingCount\" AS missing_count, \"BlockedCount\" AS blocked_count, \"AggregateRiskScore\" AS aggregate_risk_score, \"AggregateRiskLevel\" AS aggregate_risk_level, \"AlertOutcome\" AS alert_outcome FROM projection.area_cycle_snapshot ORDER BY \"SnapshotTimestamp\" DESC LIMIT 500"
        }
      ]
    },
