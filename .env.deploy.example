# NatureProtector live staging deployment placeholders.
# Copy to .env.deploy.local and fill locally; never commit real values.

NATUREPROTECTOR_PROJECT_ID=natureprotector-500518
NATUREPROTECTOR_REGION=europe-southwest1
NATUREPROTECTOR_ENVIRONMENT=staging
NATUREPROTECTOR_STAGING_TTL_HOURS=4
NATUREPROTECTOR_MONTHLY_BUDGET=20

# Required for owner-managed billing association.
NATUREPROTECTOR_BILLING_ACCOUNT_ID=<billing-account-id>
