{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "BackofficeApi": {
    "ControlPlaneEnabled": true,
    "LocalRuntimeProcessLaunchEnabled": false
  },
  "Jwt": {
    "Issuer": "NatureProtector",
    "Audience": "NatureProtector.Backoffice",
    "TokenLifetimeMinutes": 60
  },
  "AllowedHosts": "*",
  "Operations": {
    "Mode": "Disabled",
    "StoreRoot": "../NatureProtector-Operations-Data-local",
    "GitHubApiBaseUrl": "https://api.github.com",
    "GitHubRepository": "",
    "GitHubToken": "",
    "DefaultRef": "master",
    "CallbackSecret": "",
    "AllowSelfApproval": false
  }
}
