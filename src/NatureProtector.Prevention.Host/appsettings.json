{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "np",
    "Password": "np_dev_pass",
    "ExchangeName": "np.events"
  },
  "PreventionHost": {
    "PipelinePersistenceEnabled": true,
    "ConsumerPrefetchCount": 1,
    "MaxProcessingAttempts": 3,
    "RetryDelaySeconds": [ 5, 30 ],
    "RetryPollingIntervalSeconds": 5
  },
  "InfluxDb": {
    "Enabled": true,
    "FailPipelineOnWriteError": false,
    "Url": "http://localhost:8181",
    "Token": "",
    "Organization": "natureprotector",
    "Bucket": "np_telemetry",
    "Writes": {
      "AcceptedReadings": true,
      "RiskAssessments": true,
      "AreaRiskSnapshots": true
    }
  }
}
