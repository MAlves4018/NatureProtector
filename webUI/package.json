{
  "name": "webui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:toolchain": "node ./scripts/check-toolchain.mjs",
    "lint": "biome lint --diagnostic-level=error .",
    "format:check": "biome format --diagnostic-level=error biome.jsonc package.json tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:audit-script": "node --test ./scripts/check-npm-audit.test.mjs",
    "audit:ci": "node ./scripts/check-npm-audit.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "lint:all": "biome lint --config-path=biome.quality.jsonc --diagnostic-level=error --max-diagnostics=none .",
    "format:all:check": "biome format --config-path=biome.quality.jsonc --diagnostic-level=error --max-diagnostics=none .",
    "typecheck:strict": "tsc --noEmit --strict true"
  },
  "engines": {
    "node": ">=20.17.0 <21 || >=22.16.0 <23",
    "npm": ">=10.8.2"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.1",
    "clsx": "2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.17.0",
    "recharts": "2.15.2",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.4",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.8"
  }
}
